# =========================
# AI
# =========================

LLM_MODE=cloud
VLM_MODE=cloud
EMBED_MODE=cloud
RERANK_MODE=cloud


# =========================
# PostgreSQL
# =========================

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_DB=rag_db

# Database for application
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_NAME=rag_db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20


# =========================
# RabbitMQ
# =========================

RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_VHOST=/

DOCUMENTS_EXCHANGE=documents_exchange
DOCUMENTS_QUEUE=documents_queue
DOCUMENTS_ROUTING_KEY=documents.ingest


# =========================
# MinIO / S3
# =========================

S3_ENDPOINT_URL=http://minio:9000
S3_BUCKET_NAME=documents
S3_REGION=us-east-1
MINIO_ROOT_USER=admin


# =========================
# Qdrant
# =========================

QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=


# =========================
# Elasticsearch
# =========================

ELASTIC_URL=http://elasticsearch:9200
ELASTIC_API_KEY=


# =========================
# Frontend
